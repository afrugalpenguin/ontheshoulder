# Copy to .env in the repo root. Every value is optional; the defaults are shown.

# Address the api binds to. 0.0.0.0 makes it reachable from other devices on the LAN.
OTS_HOST=0.0.0.0

# Port the api listens on. The web dev server proxies /api to this port.
OTS_PORT=3001

# pino log level: fatal, error, warn, info, debug, trace or silent.
OTS_LOG_LEVEL=info

# Folder for the database and backups. Defaults to %LOCALAPPDATA%/ontheshoulder on
# Windows and ~/.local/share/ontheshoulder elsewhere. Keep it outside the repo.
# OTS_DATA_DIR=
