# Copy to .env in the repo root. Every value is optional; the defaults are shown.
#
# These are for development and tests. An installed copy keeps the data folder,
# port, LAN guard and log level in its config file (see docs/RUNBOOK.md), and
# anything set here overrides that file.

# The config file. Defaults to %LOCALAPPDATA%/ontheshoulder/config.json on
# Windows and ~/.config/ontheshoulder/config.json elsewhere.
# OTS_CONFIG=

# Address the api binds to. 0.0.0.0 makes it reachable from other devices on the LAN.
OTS_HOST=0.0.0.0

# Port the api listens on. In production it serves the web app on the same port.
# The web dev server proxies /api to this port. Leave unset to use the config file.
# OTS_PORT=3001

# pino log level: fatal, error, warn, info, debug, trace or silent.
# OTS_LOG_LEVEL=info

# Folder for the database and backups. Defaults to %LOCALAPPDATA%/ontheshoulder on
# Windows and ~/.local/share/ontheshoulder elsewhere. Keep it outside the repo.
# While this is set, the folder cannot be changed from Settings.
# OTS_DATA_DIR=

# Folder for the daily rolling log file (14 kept). Defaults to <data folder>/logs.
# OTS_LOG_DIR=

# The api refuses requests from outside your home network. Set to false to turn
# that off; leave it on unless you know why you need it off.
# OTS_LAN_GUARD=true
